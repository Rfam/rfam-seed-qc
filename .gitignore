# Python
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
dist/
build/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

Rfam.cm*
# Sequence cache location used before v1.3.0
scripts/fasta/*
.pytest_cache/

# Secrets and credentials: never commit these (the NCBI API key is read from
# the NCBI_API_KEY environment variable, never from a file in the repo)
.env
.env.*
*.env
.envrc
.netrc
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
# Specific names only: a broad *secret* pattern would also hide files such
# as .github/workflows/secret-scan.yml
.secrets
secrets.*
*.secrets
.credentials
credentials.json
*.credentials
